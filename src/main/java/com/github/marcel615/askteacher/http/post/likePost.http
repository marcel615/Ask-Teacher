### Signup user for post like check
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "post-like-user@example.com",
  "password": "password1234",
  "nickname": "postLikeUser"
}


### Login user for post like check
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "post-like-user@example.com",
  "password": "password1234"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
%}


### Create post for post like check
POST http://localhost:8080/api/posts
Content-Type: multipart/form-data; boundary=post-like-create-boundary
Authorization: Bearer {{accessToken}}

--post-like-create-boundary
Content-Disposition: form-data; name="categoryId"

1
--post-like-create-boundary
Content-Disposition: form-data; name="title"

Post like question
--post-like-create-boundary
Content-Disposition: form-data; name="content"

Manual API check post content for likes.
--post-like-create-boundary--

> {%
    client.global.set("postId", response.body.postId);
%}


### Like post
POST http://localhost:8080/api/posts/{{postId}}/likes
Authorization: Bearer {{accessToken}}

> {%
    client.test("좋아요 등록: 200과 빈 본문", function() {
        client.assert(response.status === 200);
        client.assert(!response.body);
    });
%}


### Check post like count from list
GET http://localhost:8080/api/posts


### Check post like count from detail
GET http://localhost:8080/api/posts/{{postId}}
Authorization: Bearer {{accessToken}}


### Unlike post
DELETE http://localhost:8080/api/posts/{{postId}}/likes
Authorization: Bearer {{accessToken}}

> {%
    client.test("좋아요 취소: 204와 빈 본문", function() {
        client.assert(response.status === 204);
        client.assert(!response.body);
    });
%}


### Check post like count after unlike from detail
GET http://localhost:8080/api/posts/{{postId}}
Authorization: Bearer {{accessToken}}
