### Prepare delete post - signup author
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "post-delete-author@example.com",
  "password": "password1234",
  "nickname": "postDeleteAuthor"
}


### Prepare delete post - login author
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "email": "post-delete-author@example.com",
  "password": "password1234"
}

> {%
    client.global.set("accessToken", response.body.accessToken);
%}


### Prepare delete post - create post
POST http://localhost:8080/api/posts
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=post-delete-create-boundary

--post-delete-create-boundary
Content-Disposition: form-data; name="categoryId"

1
--post-delete-create-boundary
Content-Disposition: form-data; name="title"

Spring delete target
--post-delete-create-boundary
Content-Disposition: form-data; name="content"

Post content before delete.
--post-delete-create-boundary--

> {%
    client.global.set("postId", response.body.postId);
%}


### Delete post - success
DELETE http://localhost:8080/api/posts/{{postId}}
Authorization: Bearer {{accessToken}}

> {%
    client.test("게시글 삭제: 204와 빈 본문", function() {
        client.assert(response.status === 204);
        client.assert(!response.body);
    });
%}


### Delete post - already deleted
DELETE http://localhost:8080/api/posts/{{postId}}
Authorization: Bearer {{accessToken}}


### Delete post - not found
DELETE http://localhost:8080/api/posts/999999
Authorization: Bearer {{accessToken}}
