### 게시글 목록 조회 준비
POST http://localhost:8080/api/auth/signup
Content-Type: application/json

{
  "email": "post-list-user@example.com",
  "password": "password1234",
  "nickname": "postListUser"
}


### 게시글 목록 조회 준비 - 게시글 작성
POST http://localhost:8080/api/posts
Content-Type: application/json

{
  "userId": 1,
  "categoryId": 1,
  "title": "Spring Bean question",
  "content": "Manual API check post content."
}


### 게시글 목록 조회 성공
GET http://localhost:8080/api/posts


### 게시글 목록 조회 성공 응답 예시
# HTTP/1.1 200
# {
#   "status": 200,
#   "message": "post list success message",
#   "data": [
#     {
#       "postId": 1,
#       "title": "Spring Bean question",
#       "writerNickname": "postListUser",
#       "newPost": true,
#       "createdAt": "2026-05-12T19:30:00"
#     }
#   ]
# }
