DB_NAME=askteacher
DB_USERNAME=askteacher_user
# Use at least 16 ASCII letters or digits, without quotes.
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/askteacher
POSTGRES_PORT=5432
POSTGRES_VOLUME=askteacher-postgres-data

# Development Redis; authentication sessions are lost on restart.
REDIS_HOST=localhost
REDIS_PORT=6379

# Browser origins may be comma-separated. Disable Secure only for local HTTP development.
AUTH_ALLOWED_ORIGINS=http://localhost:5173
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

# Set a unique random secret of at least 32 bytes; never commit the real value.
AUTH_CSRF_SECRET=
# Set a unique cryptographically random JWT signing secret; never commit the real value.
JWT_SECRET=
